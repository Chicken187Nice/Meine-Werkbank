# Vorlage. Nach .env kopieren und anpassen (start.sh legt .env auch selbst an).
# Die echte .env enthält deine Adressen und kommt nie ins Git.
WB_OWNER=admin
WB_HTTP_BIND=127.0.0.1
WB_HTTP_PORT=8081
WB_HTTPS_PORT=8443
WB_TLS_SAN=DNS:localhost,IP:127.0.0.1
# Nur für Zugriff aus dem Internet:
#WB_DOMAIN=deine-domain.example
#WB_TRUST_PROXY=1
# 0.0.0.0 nur, wenn dein Router die Ports 80/443 direkt auf diesen Rechner weiterleitet:
#WB_PUBLIC_BIND=127.0.0.1
# Netze, deren PROXY-Kopf (echte Besucher-IP vom Tunnel) geglaubt wird:
#WB_PROXY_ALLOW=172.16.0.0/12
# Speicher für Messenger-Anhänge je Nutzer in MB:
#WB_MSG_QUOTA_MB=300
# Nur falls Jellyfin woanders läuft:
#WB_JELLYFIN_URL=http://host.docker.internal:8096

# Lokale KI (eigene Kachel). Einrichten mit  bash ki-einrichten.sh  – das setzt WB_KI=1 selbst.
#WB_KI=1
#WB_KI_MODEL=qwen3.5:4b
# Höchstens so viele Prozessorkerne (ki-einrichten.sh trägt 75 % ein) und so viel Arbeitsspeicher für die KI:
#WB_KI_CPUS=3
#WB_KI_RAM=10g
